# Frontend Environment Configuration
# Copy this file to .env.local and update the values as needed

# API Backend URL
# For local development with Express: http://localhost:3000/api
# For production with PHP: https://surewaygroupofschools.org/api
REACT_APP_API_URL=http://localhost:3000/api

# Browser auto-open (set to 'none' to disable)
BROWSER=none

# Development server port
PORT=3001
